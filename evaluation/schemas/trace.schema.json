{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taisei-ai-trace/1",
  "title": "프레임별 trace 한 줄 (episodes/NNNN.trace.jsonl)",
  "description": "논리 프레임마다 한 줄. 브리지 관측 taisei.ai.obs/1의 부분집합과 호스트가 정한 액션·판단 시간을 합친 것이다. 이 형식은 평가 도구가 요구하는 입력이며 호스트(ai-runner/ai-policy)가 쓴다는 점은 가정이다.",
  "type": "object",
  "required": ["frame", "episode_id", "phase", "owner_state", "owner_reason", "ev_hit", "ev_death", "ev_death_uncounted", "ev_bomb", "continues", "cheat_flags", "cheat_events", "overflow", "gameover"],
  "properties": {
    "frame": {"type": "integer", "minimum": 0, "description": "obs.meta.frame"},
    "episode_id": {"type": "integer", "minimum": 1},
    "wall_ms": {"type": ["number", "null"], "minimum": 0, "description": "에피소드 시작 후 벽시계 ms. 실행 속도 계산용"},
    "phase": {"type": "integer", "minimum": 0, "maximum": 4, "description": "0 normal, 1 hit_pending, 2 dead, 3 recovering, 4 bombing"},
    "vulnerable": {"enum": [0, 1, null], "description": "obs.player.p_vulnerable"},
    "owner_state": {"type": "integer", "minimum": 0, "maximum": 2, "description": "0 manual, 1 ai_active, 2 ai_suspended"},
    "owner_reason": {"$ref": "episode.schema.json#/$defs/owner_reason"},
    "lives": {"type": ["integer", "null"]},
    "bombs": {"type": ["integer", "null"]},
    "x": {"type": ["number", "null"]},
    "y": {"type": ["number", "null"]},
    "ev_hit": {"type": "integer", "minimum": 0},
    "ev_death": {"type": "integer", "minimum": 0},
    "ev_death_uncounted": {"type": "integer", "minimum": 0},
    "ev_bomb": {"type": "integer", "minimum": 0},
    "continues": {"type": "integer", "minimum": 0},
    "cheat_flags": {"type": "integer", "minimum": 0},
    "cheat_events": {"type": "integer", "minimum": 0},
    "overflow": {"type": "integer", "minimum": 0, "description": "비트 0=탄, 1=레이저, 2=레이저 구간, 3=적"},
    "gameover": {"$ref": "episode.schema.json#/$defs/gameover"},
    "dialog_active": {"enum": [0, 1, null]},
    "hold_applied": {"type": ["integer", "null"], "description": "이 틱에 실제 적용된 hold 비트"},
    "act_hold": {"type": ["integer", "null"], "description": "이 관측을 보고 정한 hold(다음 틱 적용)"},
    "act_edges": {"type": ["integer", "null"]},
    "act_mode": {"enum": ["normal", "conservative", null]},
    "decision_ms": {"type": ["number", "null"], "minimum": 0},
    "act_applied": {"type": ["integer", "null"], "minimum": 0},
    "act_stale": {"type": ["integer", "null"], "minimum": 0},
    "act_dup": {"type": ["integer", "null"], "minimum": 0},
    "act_missing": {"type": ["integer", "null"], "minimum": 0},
    "act_rejected": {"type": ["integer", "null"], "minimum": 0},
    "act_last_obs_frame": {"type": ["integer", "null"]},
    "near": {
      "type": ["array", "null"],
      "description": "플레이어와 가까운 탄 최대 8개: [id, x, y, 반지름]. 충돌 직전 구간 설명용",
      "items": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}
    }
  },
  "additionalProperties": true
}
